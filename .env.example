# Copy to .env.local for local development. NEVER commit the real file.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# Postgres connection string (Neon or Supabase). Use the POOLED string on serverless hosts.
#   Neon:     postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#   Supabase: the "Transaction pooler" string (port 6543) from Project → Connect
# Leave EMPTY for local development: the app then uses a built-in Postgres (PGlite) stored in ./data/pglite.
DATABASE_URL=

# Only if Supabase's pooler fails with "self-signed certificate in certificate chain": set to true
PG_SSL_NO_VERIFY=

# Secret used to sign login cookies (JWT). REQUIRED in production, 32+ characters.
# Generate one:  openssl rand -base64 48
AUTH_SECRET=

# true = when the database is empty, create the demo menu, demo staff users and demo orders
AUTO_SEED=true

# Demo staff passwords used when seeding (change them if your deployment is public!)
SEED_ADMIN_PASSWORD=admin123
SEED_KITCHEN_PASSWORD=kitchen123

# Highest table number customers may enter
MAX_TABLES=30

# Timezone that decides what "today" means for revenue and order numbers
APP_TIMEZONE=Asia/Kolkata

# How often (ms) each open live stream checks the database for news
SSE_POLL_MS=1000

# Max database connections per serverless instance
PG_POOL_MAX=3

# Kitchen highlights/beeps for orders waiting longer than this many minutes (visible to the browser, set at build time)
NEXT_PUBLIC_LATE_MINUTES=15
