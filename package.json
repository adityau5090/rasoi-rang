{
  "name": "rasoi-rang",
  "version": "1.0.0",
  "private": true,
  "description": "Rasoi Rang - live restaurant ordering system (Next.js, Postgres, SSE, TanStack Query)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "seed": "tsx scripts/seed.ts",
