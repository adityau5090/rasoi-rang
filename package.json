    "typecheck": "tsc --noEmit",
    "db:check": "tsx scripts/dbcheck.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "pg": "^8.13.0",
    "@electric-sql/pglite": "^0.2.15"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/pg": "^8.11.10"
  }
}